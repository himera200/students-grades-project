@startuml 
left to right direction

actor "Студент" as Student
actor "Преподаватель" as Teacher
actor "Администратор" as Admin

rectangle "Учет оценок студентов"{
    
    usecase "Регистрация студента" as UC_RegStudent
    usecase "Регистрация преподавателя" as UC_RegTeacher
    
    usecase "Авторизация" as UC_LoginStudent
    usecase "Авторизация" as UC_LoginTeacher
    usecase "Авторизация" as UC_LoginAdmin

    usecase " Просмотр своих оценок и среднего балла" as UC_ViewGrades
    usecase " Просмотр академических задолженностей" as UC_ViewDebts


    usecase " Выставление текущей оценки студенту" as UC_AddGrade
    usecase " Редактирование ранее выставленной оценки" as UC_EditGrade
    usecase " Просмотр академической ведомости по группе" as UC_ViewGroupW
    usecase " Формирование аналитического отчёта по успеваемости" as UC_ReportGroup

    usecase " Управление учётными записями студентов" as UC_ManageStudents
    usecase " Управление учётными записями преподавателей" as UC_ManageTeachers
    usecase " Модерация справочников групп и предметов" as UC_ManageRefs
    usecase " Назначение преподавателя на учебный предмет" as UC_AssignTeacher
}

Student -- UC_RegStudent
Student -- UC_LoginStudent
Teacher -- UC_RegTeacher
Teacher -- UC_LoginTeacher
Admin -- UC_LoginAdmin


UC_LoginStudent -- UC_ViewGrades
UC_LoginStudent -- UC_ViewDebts

UC_LoginTeacher -- UC_AddGrade
UC_LoginTeacher -- UC_EditGrade
UC_LoginTeacher -- UC_ViewGroupW
UC_LoginTeacher -- UC_ReportGroup

UC_LoginAdmin -- UC_ManageStudents
UC_LoginAdmin -- UC_ManageTeachers
UC_LoginAdmin -- UC_ManageRefs
UC_LoginAdmin -- UC_AssignTeacher

@enduml