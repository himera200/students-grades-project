
@startuml 
top to bottom direction
skinparam packageStyle rectangle

actor "Студент" as Student 
actor "Преподаватель" as Teacher
actor "Администратор" as Admin

package "Сиситема учета оценок студентов" {
    usecase "Регистрация в системе" as UC_Register
    usecase "А я вторизация (Вход)" as UC_Auth
 
    usecase "Просмотр своих оценок и среднего балла" as UC_ViemGrades
    usecase "Просмотр задолжностей" as UC_ViemDebits

usecase "Выставление оценок" as UC_AddGrade
usecase "РЕдактирование оценок" as UC_EditGrade
usecase "Просмотр ведомости по группе" as UC_ViemRgistry
usecase "Формирование отчета по успеваемости" as UC_MakeReport

usecase "Управление пользователями\n(студенты, преподаватели)" as UC_ManageUsers
usecase "Управление группами и предметами" as UC_ManageGroups
usecase "Назначение преподавателяна предмет" as UC_AssgnTeacher
usecase "Управление расписанием аттестаций" as UC_ManageSchedule
}

Student -->UC_Register
Teacher-->UC_Register
Admin-->UC_Register

Student-->UC_Auth
Teacher-->UC_Auth
Admin-->UC_Auth

Student-->UC_ViemGrades
Student-->UC_ViemDebits

Teacher-->UC_AddGrade
Teacher-->UC_EditGrade
Teacher-->UC_ViemRgistry
Teacher-->UC_MakeReport

Admin-->UC_ManageUsers
Admin-->UC_ManageGroups
Admin-->UC_AssgnTeacher
Admin-->UC_ManageSchedule
@enduml
