@startuml
left to right direction
skinparam packageStyle rectangle

actor "Гость" as Guest
actor "Студент" as Student
actor "Преподаватель" as Teacher
actor "Администратор" as Admin

rectangle "Система «Учёт оценок студентов»" {
    usecase "UC-1: Регистрация и авторизация" as UC_Auth
    
    usecase "UC-2: Просмотр своих оценок и среднего балла" as UC_ViewGrades
    usecase "UC-3: Просмотр задолженностей" as UC_ViewDebts
    
    usecase "UC-4: Выставление оценки студенту" as UC_AddGrade
    usecase "UC-5: Редактирование ранее выставленной оценки" as UC_EditGrade
    usecase "UC-6: Просмотр ведомости по группе" as UC_ViewGroupW
    usecase "UC-7: Формирование отчёта по успеваемости группы" as UC_ReportGroup
    
    usecase "UC-8: Управление студентами\n(добавление, изменение, удаление)" as UC_ManageStudents
    usecase "UC-9: Управление преподавателями" as UC_ManageTeachers
    usecase "UC-10: Управление группами и предметами" as UC_ManageRefs
    usecase "UC-11: Назначение преподавателя на предмет" as UC_AssignTeacher
}

' --- БЛОК СВЯЗЕЙ ДЛЯ ГОСТЯ ---
Guest -- UC_Auth

' --- БЛОК СВЯЗЕЙ ДЛЯ СТУДЕНТА ---
Student -- UC_Auth
Student -- UC_ViewGrades
Student -- UC_ViewDebts

' --- БЛОК СВЯЗЕЙ ДЛЯ ПРЕПОДАВАТЕЛЯ ---
Teacher -- UC_Auth
Teacher -- UC_AddGrade
Teacher -- UC_EditGrade
Teacher -- UC_ViewGroupW
Teacher -- UC_ReportGroup

' --- БЛОК СВЯЗЕЙ ДЛЯ АДМИНИСТРАТОРА ---
Admin -- UC_Auth
Admin -- UC_ManageStudents
Admin -- UC_ManageTeachers
Admin -- UC_ManageRefs
Admin -- UC_AssignTeacher

@enduml
