@startuml
left to right direction
skinparam packageStyle rectangle

actor "Студент" as Student
actor "Преподаватель" as Teacher
actor "Администратор" as Admin

' 1. МОДУЛЬ СТУДЕНТА
rectangle "Подсистема: Личный кабинет Студента" {
    usecase "UC-1: Просмотр личных оценок и среднего балла" as UC_ViewGrades
    usecase "UC-2: Просмотр академических задолженностей" as UC_ViewDebts
}

' 2. МОДУЛЬ ПРЕПОДАВАТЕЛЯ
rectangle "Подсистема: АРМ Преподавателя" {
    usecase "UC-3: Выставление текущей оценки студенту" as UC_AddGrade
    usecase "UC-4: Редактирование ранее выставленной оценки" as UC_EditGrade
    usecase "UC-5: Просмотр академической ведомости по группе" as UC_ViewGroupW
    usecase "UC-6: Формирование аналитического отчёта по успеваемости" as UC_ReportGroup
}

' 3. МОДУЛЬ АДМИНИСТРАТОРА
rectangle "Подсистема: Панель Администратора" {
    usecase "UC-7: Управление учётными записями студентов" as UC_ManageStudents
    usecase "UC-8: Управление учётными записями преподавателей" as UC_ManageTeachers
    usecase "UC-9: Модерация справочников групп и предметов" as UC_ManageRefs
    usecase "UC-10: Назначение преподавателя на учебный предмет" as UC_AssignTeacher
}

' --- Связи авторизованного Студента ---
Student -- UC_ViewGrades
Student -- UC_ViewDebts

' --- Связи авторизованного Преподавателя ---
Teacher -- UC_AddGrade
Teacher -- UC_EditGrade
Teacher -- UC_ViewGroupW
Teacher -- UC_ReportGroup

' --- Связи авторизованного Администратора ---
Admin -- UC_ManageStudents
Admin -- UC_ManageTeachers
Admin -- UC_ManageRefs
Admin -- UC_AssignTeacher

@enduml
